---
export const prerender = false;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('Referrer-Policy', 'no-referrer');
Astro.response.headers.set('X-Content-Type-Options', 'nosniff');
Astro.response.headers.set('X-Robots-Tag', 'noindex');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>Return to Orbyt</title>
    <link rel="stylesheet" href="/css/fonts.css" />
    <style>
      :root { color-scheme: dark; }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        min-height: 100vh;
        min-height: 100dvh;
        display: grid;
        place-items: center;
        padding: 2rem;
        background: #000;
        color: #f3f5fe;
        font-family: 'Figtree', -apple-system, BlinkMacSystemFont, sans-serif;
      }
      main { max-width: 28rem; text-align: center; }
      img { width: 6rem; height: 6rem; object-fit: contain; }
      h1 { margin: 1rem 0 0.5rem; font-size: clamp(1.75rem, 5vw, 2.5rem); }
      p { margin: 0; color: #a9acb8; font-size: 1.0625rem; line-height: 1.5; }
    </style>
  </head>
  <body>
    <main>
      <img src="/images/orbyt-logo.png" alt="Orbyt" />
      <h1>Return to Orbyt</h1>
      <p>If Orbyt did not reopen automatically, return to the app and start sign-in again.</p>
    </main>
  </body>
</html>
